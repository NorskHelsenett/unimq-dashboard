{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/v1/cluster": {
            "get": {
                "description": "Get overall cluster statistics and health information",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Cluster"
                ],
                "summary": "Get Cluster Stats",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ClusterStats"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/maintenance": {
            "get": {
                "description": "Get scheduled  maintenance information and history",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Maintenance"
                ],
                "summary": "Get scheduled  maintenance information and history",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.MaintenanceResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            },
            "post": {
                "description": "Add new maintenance entry with description, start time, and end time",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Maintenance"
                ],
                "summary": "Add new maintenance entry",
                "parameters": [
                    {
                        "description": "Maintenance Entry Data",
                        "name": "entry",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.MaintenanceEntry"
                        }
                    }
                ],
                "responses": {
                    "303": {
                        "description": "Redirect to maintenance admin page with success message",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/maintenance/admin": {
            "get": {
                "description": "Get all maintenance entries for admin view",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Maintenance"
                ],
                "summary": "Get all maintenance entries",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.MaintenanceAdminResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/vhosts": {
            "get": {
                "description": "Get a list of all vhosts in the RabbitMQ cluster",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Vhosts"
                ],
                "summary": "Get all vhosts",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/models.Vhost"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/vhosts/{vhost}": {
            "get": {
                "description": "Get details of a specific vhost by name",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Vhosts"
                ],
                "summary": "Get vhost details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Vhost Name",
                        "name": "vhost",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Vhost"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/vhosts/{vhost}/queues": {
            "get": {
                "description": "Fetches time-series metrics for a specific RabbitMQ queue over a specified time range.",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Metrics"
                ],
                "summary": "Get Queue Metrics for a specific queue in the specified virtual host",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Virtual Host",
                        "name": "vhost",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Queue Name",
                        "name": "name",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "1h",
                        "description": "Time Range (e.g., 1h, 24h, 7d)",
                        "name": "range",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML page with queue metrics",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        },
        "/v1/vhosts/{vhost}/queues/{queue}": {
            "get": {
                "description": "Fetches details of all queues in a specified virtual host.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Queues"
                ],
                "summary": "Get All Queues to a specified virtual host",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Virtual Host",
                        "name": "vhost",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of queue details",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.QueueDetail"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/httpsuite.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "httpsuite.APIError": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "models.ClusterStats": {
            "type": "object",
            "properties": {
                "min_disk_limit": {
                    "type": "integer"
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.NodeStats"
                    }
                },
                "total_disk_free": {
                    "type": "integer"
                },
                "total_mem_limit": {
                    "type": "integer"
                },
                "total_mem_used": {
                    "type": "integer"
                },
                "vhost_resources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.VhostResources"
                    }
                }
            }
        },
        "models.MaintenanceAdminResponse": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.MaintenanceEntry"
                    }
                }
            }
        },
        "models.MaintenanceEntry": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "end": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "notified": {
                    "type": "boolean"
                },
                "start": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/models.MaintenanceStatus"
                }
            }
        },
        "models.MaintenanceResponse": {
            "type": "object",
            "properties": {
                "history": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.MaintenanceEntry"
                    }
                },
                "scheduled": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.MaintenanceEntry"
                    }
                }
            }
        },
        "models.MaintenanceStatus": {
            "type": "string",
            "enum": [
                "scheduled",
                "done",
                "skipped",
                "unknown"
            ],
            "x-enum-varnames": [
                "MaintenanceStatusScheduled",
                "MaintenanceStatusDone",
                "MaintenanceStatusSkipped",
                "MaintenanceStatusUnknown"
            ]
        },
        "models.MessageRate": {
            "type": "object",
            "properties": {
                "rate": {
                    "type": "number"
                }
            }
        },
        "models.Metadata": {
            "type": "object",
            "properties": {
                "default_queue_type": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.NodeStats": {
            "type": "object",
            "properties": {
                "disk_free": {
                    "type": "integer"
                },
                "disk_free_limit": {
                    "type": "integer"
                },
                "mem_limit": {
                    "type": "integer"
                },
                "mem_used": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.QueueDetail": {
            "type": "object",
            "properties": {
                "consumers": {
                    "type": "integer"
                },
                "deliver_rate": {
                    "type": "number"
                },
                "history": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "message_bytes": {
                    "type": "integer"
                },
                "messages": {
                    "type": "integer"
                },
                "messages_unacknowledged": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "publish_rate": {
                    "type": "number"
                },
                "redeliver_rate": {
                    "type": "number"
                }
            }
        },
        "models.Vhost": {
            "type": "object",
            "properties": {
                "cluster_state": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "default_queue_type": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "messages": {
                    "type": "integer"
                },
                "messages_details": {
                    "$ref": "#/definitions/models.MessageRate"
                },
                "messages_ready": {
                    "type": "integer"
                },
                "messages_ready_details": {
                    "$ref": "#/definitions/models.MessageRate"
                },
                "messages_unacknowledged": {
                    "type": "integer"
                },
                "messages_unacknowledged_details": {
                    "$ref": "#/definitions/models.MessageRate"
                },
                "metadata": {
                    "$ref": "#/definitions/models.Metadata"
                },
                "name": {
                    "type": "string"
                },
                "protected_from_deletion": {
                    "type": "boolean"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tracing": {
                    "type": "boolean"
                }
            }
        },
        "models.VhostResources": {
            "type": "object",
            "properties": {
                "disk_bytes": {
                    "type": "integer"
                },
                "message_bytes": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
}